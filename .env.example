# ---------------------------------------------------------------------------
# Whoop OAuth credentials
# Get these from https://developer.whoop.com -> your app
# ---------------------------------------------------------------------------
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI registered on the Whoop developer portal.
# Local:    http://localhost:8000/auth/callback
# Deployed: https://<your-project>.vercel.app/auth/callback
WHOOP_REDIRECT_URI=http://localhost:8000/auth/callback

# Space-separated OAuth scopes. "offline" is required to receive a refresh
# token (without it the daily cron sync cannot renew access).
WHOOP_SCOPES=offline read:recovery read:cycles read:sleep read:workout read:profile read:body_measurement

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Local Docker:  postgresql+psycopg://whoop:whoop@localhost:5432/whoop
# Hosted (Vercel Postgres / Neon / Supabase): use their connection string,
# prefixed with the SQLAlchemy driver. Prefer the *pooled* host for serverless.
#   postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://whoop:whoop@localhost:5432/whoop

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Random string used to sign the OAuth state cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_random_string

# ---------------------------------------------------------------------------
# Daily cron sync (Vercel)
# ---------------------------------------------------------------------------
# Shared secret protecting GET /cron/sync. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this env var is set on the project.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=change_me_to_a_random_string

# Days of history re-fetched on each daily sync (catches late-finalized scores).
SYNC_LOOKBACK_DAYS=7

# Set false once tables exist to skip DDL on every serverless cold start.
AUTO_CREATE_TABLES=true
